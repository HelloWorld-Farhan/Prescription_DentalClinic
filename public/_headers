# Smile Clinic Cloudflare Pages Cache Rules
# Prevent stale index.html from caching old chunk hashes across client devices
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate

# Static content-hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

